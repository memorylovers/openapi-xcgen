{
  "metadata": {
    "title": "Complex Schema API",
    "version": "1.0.0",
    "description": "API with complex nested schemas"
  },
  "components": [
    {
      "kind": "object",
      "name": "Order",
      "referencePath": "#/components/schemas/Order",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "validation": {
            "format": "uuid"
          }
        },
        {
          "name": "items",
          "type": {
            "kind": "ref",
            "referencePath": "#/components/schemas/Order/OrderItems"
          },
          "required": true,
          "validation": {
            "minItems": 1
          }
        },
        {
          "name": "customer",
          "type": {
            "kind": "ref",
            "referencePath": "#/components/schemas/Order/OrderCustomer"
          },
          "required": true
        },
        {
          "name": "status",
          "type": {
            "kind": "ref",
            "referencePath": "#/components/schemas/Order/OrderStatus"
          }
        },
        {
          "name": "priority",
          "type": {
            "kind": "ref",
            "referencePath": "#/components/schemas/Order/OrderPriority"
          }
        },
        {
          "name": "tags",
          "type": {
            "kind": "ref",
            "referencePath": "#/components/schemas/Order/OrderTags"
          }
        },
        {
          "name": "metadata",
          "type": {
            "kind": "ref",
            "referencePath": "#/components/schemas/Order/OrderMetadata"
          }
        },
        {
          "name": "createdAt",
          "type": "datetime"
        },
        {
          "name": "updatedAt",
          "type": "datetime"
        }
      ]
    },
    {
      "kind": "array",
      "name": "OrderItems",
      "referencePath": "#/components/schemas/Order/OrderItems",
      "itemType": {
        "kind": "ref",
        "referencePath": "#/components/schemas/Order/OrderItemsItem"
      },
      "validation": {
        "minItems": 1
      }
    },
    {
      "kind": "object",
      "name": "OrderItemsItem",
      "referencePath": "#/components/schemas/Order/OrderItemsItem",
      "properties": [
        {
          "name": "productId",
          "type": "string",
          "required": true
        },
        {
          "name": "quantity",
          "type": "int",
          "required": true,
          "validation": {
            "minimum": 1
          }
        },
        {
          "name": "price",
          "type": "float",
          "validation": {
            "format": "float"
          }
        },
        {
          "name": "discount",
          "type": "float",
          "validation": {
            "minimum": 0,
            "maximum": 100,
            "format": "float"
          }
        }
      ]
    },
    {
      "kind": "object",
      "name": "OrderCustomer",
      "referencePath": "#/components/schemas/Order/OrderCustomer",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "email",
          "type": "string",
          "validation": {
            "format": "email"
          }
        },
        {
          "name": "address",
          "type": {
            "kind": "ref",
            "referencePath": "#/components/schemas/Order/OrderCustomer/OrderCustomerAddress"
          }
        }
      ]
    },
    {
      "kind": "object",
      "name": "OrderCustomerAddress",
      "referencePath": "#/components/schemas/Order/OrderCustomer/OrderCustomerAddress",
      "properties": [
        {
          "name": "street",
          "type": "string"
        },
        {
          "name": "city",
          "type": "string"
        },
        {
          "name": "country",
          "type": "string"
        },
        {
          "name": "zipCode",
          "type": "string",
          "validation": {
            "pattern": "^\\d{5}(-\\d{4})?$"
          }
        }
      ]
    },
    {
      "kind": "enum",
      "name": "OrderStatus",
      "referencePath": "#/components/schemas/Order/OrderStatus",
      "type": "string",
      "values": [
        {
          "value": "pending",
          "name": "PENDING"
        },
        {
          "value": "processing",
          "name": "PROCESSING"
        },
        {
          "value": "shipped",
          "name": "SHIPPED"
        },
        {
          "value": "delivered",
          "name": "DELIVERED"
        },
        {
          "value": "cancelled",
          "name": "CANCELLED"
        }
      ]
    },
    {
      "kind": "enum",
      "name": "OrderPriority",
      "referencePath": "#/components/schemas/Order/OrderPriority",
      "type": "string",
      "values": [
        {
          "value": "low",
          "name": "LOW"
        },
        {
          "value": "normal",
          "name": "NORMAL"
        },
        {
          "value": "high",
          "name": "HIGH"
        },
        {
          "value": "urgent",
          "name": "URGENT"
        }
      ]
    },
    {
      "kind": "array",
      "name": "OrderTags",
      "referencePath": "#/components/schemas/Order/OrderTags",
      "itemType": "string"
    },
    {
      "kind": "map",
      "name": "OrderMetadata",
      "referencePath": "#/components/schemas/Order/OrderMetadata",
      "valueType": "string"
    }
  ],
  "tags": [],
  "endpoints": [
    {
      "path": "/orders",
      "method": "post",
      "operationId": "createOrder",
      "summary": "Create a new order",
      "tags": [
        "orders"
      ],
      "parameters": [],
      "requestBody": {
        "kind": "content",
        "content": [
          {
            "mimeType": "application/json",
            "schema": {
              "kind": "ref",
              "referencePath": "#/components/schemas/Order"
            }
          }
        ],
        "required": true
      },
      "responses": [
        {
          "kind": "content",
          "statusCode": "201",
          "description": "Order created",
          "content": [
            {
              "mimeType": "application/json",
              "schema": {
                "kind": "ref",
                "referencePath": "#/components/schemas/Order"
              }
            }
          ]
        }
      ]
    }
  ]
}
