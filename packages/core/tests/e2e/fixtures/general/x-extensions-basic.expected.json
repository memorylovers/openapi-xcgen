{
  "metadata": {
    "title": "X-Extensions Basic Test API",
    "version": "1.0.0",
    "description": "API for testing x-extensions support at various levels"
  },
  "components": [
    {
      "kind": "object",
      "name": "User",
      "referencePath": "#/components/schemas/User",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "extensions": {
            "x-property-extension": "id-field",
            "x-db-type": "uuid"
          }
        },
        {
          "name": "name",
          "type": "string",
          "extensions": {
            "x-property-extension": "name-field",
            "x-searchable": true
          }
        },
        {
          "name": "email",
          "type": "string",
          "validation": {
            "format": "email"
          },
          "extensions": {
            "x-property-extension": "email-field",
            "x-unique": true
          }
        },
        {
          "name": "age",
          "type": "int",
          "extensions": {
            "x-property-extension": "age-field",
            "x-min": 0,
            "x-max": 150
          }
        }
      ]
    },
    {
      "kind": "object",
      "name": "Post",
      "referencePath": "#/components/schemas/Post",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "extensions": {
            "x-db-type": "uuid"
          }
        },
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "content",
          "type": "string"
        },
        {
          "name": "authorId",
          "type": "string",
          "extensions": {
            "x-foreign-key": "users.id"
          }
        }
      ]
    },
    {
      "kind": "enum",
      "name": "Status",
      "referencePath": "#/components/schemas/Status",
      "type": "string",
      "values": [
        {
          "value": "active",
          "name": "ACTIVE"
        },
        {
          "value": "inactive",
          "name": "INACTIVE"
        },
        {
          "value": "pending",
          "name": "PENDING"
        }
      ],
      "extensions": {
        "x-enum-extension": "Status-enum",
        "x-default-value": "pending"
      }
    },
    {
      "kind": "parameter",
      "name": "GetUsersIdParams",
      "referencePath": "#/paths/::users::{id}/get/GetUsersIdParams",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "in": "path",
          "required": true,
          "extensions": {
            "x-parameter-extension": "path-parameter",
            "x-validation-rule": "uuid-v4"
          }
        },
        {
          "name": "include",
          "type": "string",
          "in": "query",
          "extensions": {
            "x-parameter-extension": "query-parameter",
            "x-allowed-values": [
              "profile",
              "settings"
            ]
          }
        }
      ],
      "description": "Parameters for GET /users/{id}"
    },
    {
      "kind": "requestBody",
      "name": "PostPostsRequestBody",
      "referencePath": "#/paths/::posts/post/requestBody/content/application::json/schema",
      "properties": [
        {
          "name": "title",
          "type": "string",
          "extensions": {
            "x-property-extension": "title-field",
            "x-min-length": 1,
            "x-max-length": 200
          }
        },
        {
          "name": "content",
          "type": "string",
          "extensions": {
            "x-property-extension": "content-field",
            "x-format": "markdown"
          }
        },
        {
          "name": "tags",
          "type": {
            "kind": "ref",
            "referencePath": "#/paths/::posts/post/requestBody/content/application::json/PostPostsRequestBodyTags"
          },
          "extensions": {
            "x-property-extension": "tags-field",
            "x-max-items": 10
          }
        }
      ],
      "required": true
    },
    {
      "kind": "array",
      "name": "PostPostsRequestBodyTags",
      "referencePath": "#/paths/::posts/post/requestBody/content/application::json/PostPostsRequestBodyTags",
      "itemType": "string"
    }
  ],
  "tags": [],
  "endpoints": [
    {
      "path": "/users/{id}",
      "method": "get",
      "operationId": "getUser",
      "summary": "Get user by ID",
      "tags": [],
      "parameters": {
        "kind": "ref",
        "referencePath": "#/paths/::users::{id}/get/GetUsersIdParams"
      },
      "responses": [
        {
          "kind": "content",
          "statusCode": "200",
          "description": "User found",
          "content": [
            {
              "mimeType": "application/json",
              "schema": {
                "kind": "ref",
                "referencePath": "#/components/schemas/User"
              }
            }
          ]
        },
        {
          "kind": "content",
          "statusCode": "404",
          "description": "User not found"
        }
      ],
      "extensions": {
        "x-path-item-extension": "Path Item Level",
        "x-path-custom": true,
        "x-operation-extension": "Operation Level",
        "x-rate-limit": 100
      }
    },
    {
      "path": "/posts",
      "method": "post",
      "operationId": "createPost",
      "summary": "Create a new post",
      "tags": [],
      "parameters": [],
      "requestBody": {
        "kind": "content",
        "content": [
          {
            "mimeType": "application/json",
            "schema": {
              "kind": "ref",
              "referencePath": "#/paths/::posts/post/requestBody/content/application::json/schema"
            }
          }
        ],
        "required": true
      },
      "responses": [
        {
          "kind": "content",
          "statusCode": "201",
          "description": "Post created",
          "content": [
            {
              "mimeType": "application/json",
              "schema": {
                "kind": "ref",
                "referencePath": "#/components/schemas/Post"
              }
            }
          ]
        }
      ],
      "extensions": {
        "x-auth-required": true,
        "x-scopes": [
          "write:posts"
        ]
      }
    }
  ]
}
