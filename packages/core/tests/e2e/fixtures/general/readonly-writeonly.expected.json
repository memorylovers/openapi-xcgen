{
  "metadata": {
    "title": "ReadOnly/WriteOnly Test API",
    "version": "1.0.0",
    "description": "API for testing readOnly and writeOnly properties"
  },
  "components": [
    {
      "kind": "object",
      "name": "User",
      "referencePath": "#/components/schemas/User",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "User ID (generated by server)",
          "readOnly": true
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "Username"
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "description": "Email address",
          "validation": {
            "format": "email"
          }
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "description": "Account creation timestamp",
          "readOnly": true
        },
        {
          "name": "updatedAt",
          "type": "datetime",
          "description": "Last update timestamp",
          "readOnly": true
        }
      ],
      "description": "User model with readOnly fields"
    },
    {
      "kind": "object",
      "name": "UserCreate",
      "referencePath": "#/components/schemas/UserCreate",
      "properties": [
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "Username"
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "description": "Email address",
          "validation": {
            "format": "email"
          }
        },
        {
          "name": "password",
          "type": "string",
          "required": true,
          "description": "Password (not returned in responses)",
          "writeOnly": true,
          "validation": {
            "format": "password"
          }
        },
        {
          "name": "confirmPassword",
          "type": "string",
          "required": true,
          "description": "Password confirmation",
          "writeOnly": true,
          "validation": {
            "format": "password"
          }
        }
      ],
      "description": "User creation model with writeOnly fields"
    },
    {
      "kind": "object",
      "name": "UserUpdate",
      "referencePath": "#/components/schemas/UserUpdate",
      "properties": [
        {
          "name": "username",
          "type": "string",
          "description": "Username"
        },
        {
          "name": "email",
          "type": "string",
          "description": "Email address",
          "validation": {
            "format": "email"
          }
        },
        {
          "name": "currentPassword",
          "type": "string",
          "description": "Current password for verification",
          "writeOnly": true,
          "validation": {
            "format": "password"
          }
        },
        {
          "name": "newPassword",
          "type": "string",
          "description": "New password",
          "writeOnly": true,
          "validation": {
            "format": "password"
          }
        },
        {
          "name": "lastLoginAt",
          "type": "datetime",
          "description": "Last login timestamp (server-managed)",
          "readOnly": true
        }
      ],
      "description": "User update model with both readOnly and writeOnly fields"
    },
    {
      "kind": "parameter",
      "name": "GetUsersUserIdParams",
      "referencePath": "#/paths/::users::{userId}/get/GetUsersUserIdParams",
      "properties": [
        {
          "name": "userId",
          "type": "string",
          "in": "path",
          "required": true
        }
      ],
      "description": "Parameters for GET /users/{userId}"
    },
    {
      "kind": "parameter",
      "name": "PatchUsersUserIdParams",
      "referencePath": "#/paths/::users::{userId}/patch/PatchUsersUserIdParams",
      "properties": [
        {
          "name": "userId",
          "type": "string",
          "in": "path",
          "required": true
        }
      ],
      "description": "Parameters for PATCH /users/{userId}"
    }
  ],
