{
  "info": {
    "title": "Multi-Service API",
    "version": "2.0.0",
    "description": "API with multiple services/tags"
  },
  "models": [
    {
      "name": "User",
      "referencePath": "#/components/schemas/User",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": false
        },
        {
          "name": "name",
          "type": "string",
          "required": false
        },
        {
          "name": "email",
          "type": "string",
          "required": false,
          "validation": {
            "format": "email"
          }
        },
        {
          "name": "role",
          "type": {
            "kind": "ref",
            "name": "UserRole"
          },
          "required": false,
          "validation": {
            "enum": [
              "admin",
              "user",
              "guest"
            ]
          }
        }
      ]
    },
    {
      "name": "NewPost",
      "referencePath": "#/components/schemas/NewPost",
      "properties": [
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "content",
          "type": "string",
          "required": true
        },
        {
          "name": "authorId",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "GetUsersParams",
      "description": "Parameters for GET /users/{userId}",
      "properties": [
        {
          "name": "userId",
          "type": "string",
          "required": true
        }
      ],
      "referencePath": "#/paths/::users::{userId}/get/parameters/GetUsersParams"
    }
  ],
  "enums": [
    {
      "name": "UserRole",
      "referencePath": "#/components/schemas/UserRole",
      "type": "string",
      "values": [
        {
          "value": "admin",
          "name": "ADMIN"
        },
        {
          "value": "user",
          "name": "USER"
        },
        {
          "value": "guest",
          "name": "GUEST"
        }
      ]
    }
  ],
  "services": [
    {
      "name": "users",
      "endpoints": [
        {
          "id": "listUsers",
          "method": "get",
          "path": "/users",
          "summary": "List all users",
          "parameters": [],
          "responses": [
            {
              "statusCode": "200",
              "description": "List of users",
              "content": {
                "application/json": {
                  "kind": "array",
                  "itemType": {
                    "kind": "ref",
                    "name": "User"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "getUser",
          "method": "get",
          "path": "/users/{userId}",
          "summary": "Get user by ID",
          "parameters": [
            {
              "name": "userId",
              "in": "path",
              "required": true,
              "type": "string"
            }
          ],
          "responses": [
            {
              "statusCode": "200",
              "description": "User details",
              "content": {
                "application/json": {
                  "kind": "ref",
                  "name": "User"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "posts",
      "endpoints": [
        {
          "id": "listPosts",
          "method": "get",
          "path": "/posts",
          "summary": "List all posts",
          "parameters": [],
          "responses": [
            {
              "statusCode": "200",
              "description": "List of posts"
            }
          ]
        },
        {
          "id": "createPost",
          "method": "post",
          "path": "/posts",
          "summary": "Create a new post",
          "parameters": [],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "kind": "ref",
                "name": "NewPost"
              }
            }
          },
          "responses": [
            {
              "statusCode": "201",
              "description": "Post created"
            }
          ]
        }
      ]
    },
    {
      "name": "admin",
      "endpoints": [
        {
          "id": "getSettings",
          "method": "get",
          "path": "/admin/settings",
          "summary": "Get admin settings",
          "parameters": [],
          "responses": [
            {
              "statusCode": "200",
              "description": "Settings retrieved"
            }
          ]
        }
      ]
    },
    {
      "name": "default",
      "endpoints": [
        {
          "id": "healthCheck",
          "method": "get",
          "path": "/health",
          "summary": "Health check endpoint",
          "parameters": [],
          "responses": [
            {
              "statusCode": "200",
              "description": "Service is healthy"
            }
          ]
        }
      ]
    }
  ]
}
