{
  "info": {
    "title": "Petstore API",
    "version": "1.0.0",
    "description": "A simple petstore API"
  },
  "models": [
    {
      "kind": "object",
      "name": "Pet",
      "referencePath": "#/components/schemas/Pet",
      "properties": [
        {
          "name": "id",
          "type": "long",
          "required": true,
          "validation": {
            "format": "int64"
          }
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "tag",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "kind": "object",
      "name": "NewPet",
      "referencePath": "#/components/schemas/NewPet",
      "properties": [
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "tag",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "kind": "object",
      "name": "Error",
      "referencePath": "#/components/schemas/Error",
      "properties": [
        {
          "name": "code",
          "type": "int",
          "required": true,
          "validation": {
            "format": "int32"
          }
        },
        {
          "name": "message",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "kind": "parameter",
      "name": "GetPetsParams",
      "description": "Parameters for GET /pets\nlimit: How many items to return at one time",
      "properties": [
        {
          "name": "limit",
          "type": "int",
          "required": false,
          "in": "query",
          "description": "How many items to return at one time",
          "defaultValue": 20
        }
      ],
      "referencePath": "#/paths/::pets/get/parameters/GetPetsParams"
    },
    {
      "kind": "parameter",
      "name": "GetPetsParams",
      "description": "Parameters for GET /pets/{petId}\npetId: The id of the pet to retrieve",
      "properties": [
        {
          "name": "petId",
          "type": "string",
          "required": true,
          "in": "path",
          "description": "The id of the pet to retrieve"
        }
      ],
      "referencePath": "#/paths/::pets::{petId}/get/parameters/GetPetsParams"
    }
  ],
  "services": [
    {
      "name": "pets",
      "endpoints": [
        {
          "id": "listPets",
          "method": "get",
          "path": "/pets",
          "summary": "List all pets",
          "parameters": {
            "kind": "ref",
            "name": "#/paths/::pets/get/parameters/GetPetsParams"
          },
          "responses": [
            {
              "statusCode": "200",
              "description": "A paged array of pets",
              "content": [
                {
                  "mimeType": "application/json",
                  "schema": {
                    "kind": "array",
                    "itemType": {
                      "kind": "ref",
                      "name": "#/components/schemas/Pet"
                    }
                  }
                }
              ]
            },
            {
              "statusCode": "500",
              "description": "Unexpected error",
              "content": [
                {
                  "mimeType": "application/json",
                  "schema": {
                    "kind": "ref",
                    "name": "#/components/schemas/Error"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "createPet",
          "method": "post",
          "path": "/pets",
          "summary": "Create a pet",
          "parameters": [],
          "responses": [
            {
              "statusCode": "201",
              "description": "Pet created",
              "content": [
                {
                  "mimeType": "application/json",
                  "schema": {
                    "kind": "ref",
                    "name": "#/components/schemas/Pet"
                  }
                }
              ]
            },
            {
              "statusCode": "500",
              "description": "Unexpected error",
              "content": [
                {
                  "mimeType": "application/json",
                  "schema": {
                    "kind": "ref",
                    "name": "#/components/schemas/Error"
                  }
                }
              ]
            }
          ],
          "requestBody": {
            "required": true,
            "content": [
              {
                "mimeType": "application/json",
                "schema": {
                  "kind": "ref",
                  "name": "#/components/schemas/NewPet"
                }
              }
            ]
          }
        },
        {
          "id": "getPetById",
          "method": "get",
          "path": "/pets/{petId}",
          "summary": "Info for a specific pet",
          "parameters": {
            "kind": "ref",
            "name": "#/paths/::pets::{petId}/get/parameters/GetPetsParams"
          },
          "responses": [
            {
              "statusCode": "200",
              "description": "Expected response to a valid request",
              "content": [
                {
                  "mimeType": "application/json",
                  "schema": {
                    "kind": "ref",
                    "name": "#/components/schemas/Pet"
                  }
                }
              ]
            },
            {
              "statusCode": "404",
              "description": "Pet not found"
            },
            {
              "statusCode": "500",
              "description": "Unexpected error",
              "content": [
                {
                  "mimeType": "application/json",
                  "schema": {
                    "kind": "ref",
                    "name": "#/components/schemas/Error"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
