{
  "info": {
    "title": "Validation Model Test",
    "version": "1.0.0",
    "description": "Test validation constraints"
  },
  "models": [
    {
      "kind": "object",
      "name": "Product",
      "referencePath": "#/components/schemas/Product",
      "properties": [
        {
          "name": "name",
          "type": "string",
          "required": false,
          "validation": {
            "minLength": 1,
            "maxLength": 100
          }
        },
        {
          "name": "code",
          "type": "string",
          "required": false,
          "validation": {
            "pattern": "^[A-Z]{3}$"
          }
        },
        {
          "name": "userId",
          "type": "string",
          "required": false,
          "validation": {
            "format": "uuid"
          }
        },
        {
          "name": "email",
          "type": "string",
          "required": false,
          "validation": {
            "format": "email"
          }
        },
        {
          "name": "website",
          "type": "string",
          "required": false,
          "validation": {
            "format": "uri"
          }
        },
        {
          "name": "ipAddress",
          "type": "string",
          "required": false,
          "validation": {
            "format": "ipv4"
          }
        },
        {
          "name": "price",
          "type": "double",
          "required": false,
          "validation": {
            "minimum": 0,
            "maximum": 1000
          }
        },
        {
          "name": "quantity",
          "type": "int",
          "required": false,
          "validation": {
            "minimum": 1
          }
        },
        {
          "name": "tags",
          "type": {
            "kind": "array",
            "itemType": "string"
          },
          "required": false,
          "validation": {
            "minItems": 1,
            "maxItems": 5
          }
        }
      ]
    }
  ],
  "services": [
    {
      "name": "default",
      "endpoints": [
        {
          "id": null,
          "method": "get",
          "path": "/products",
          "summary": "Get products",
          "parameters": [],
          "responses": [
            {
              "statusCode": "200",
              "description": "Success",
              "content": [
                {
                  "mimeType": "application/json",
                  "schema": {
                    "kind": "ref",
                    "name": "#/components/schemas/Product"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
