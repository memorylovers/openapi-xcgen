  "services": [
    {
      "name": "default",
      "endpoints": [
        {
          "id": "testParametersModelGeneration",
          "method": "get",
          "path": "/test-1-parameters/{id}",
          "summary": "Test 1: Parameters model generation (Basic)",
          "description": "Validates parameter model generation with all parameter types (path/query/header/cookie). Tests: enum parameters, required/optional mixing, default values, parameter type conversion.",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "description": "Path parameter - always required",
              "required": true,
              "type": "string"
            },
            {
              "name": "category",
              "in": "query",
              "description": "Optional enum query parameter",
              "required": false,
              "type": "string"
            },
            {
              "name": "status",
              "in": "query",
              "description": "Required enum query parameter",
              "required": true,
              "type": "string"
            },
            {
              "name": "limit",
              "in": "query",
              "description": "Optional integer parameter with default value",
              "required": false,
              "type": "int",
              "defaultValue": 20
            },
            {
              "name": "includeDetails",
              "in": "query",
              "description": "Optional boolean parameter with default value",
              "required": false,
              "type": "boolean",
              "defaultValue": false
            },
            {
              "name": "Authorization",
              "in": "header",
              "description": "Optional header parameter",
              "required": false,
              "type": "string"
            },
            {
              "name": "sessionId",
              "in": "cookie",
              "description": "Optional cookie parameter",
              "required": false,
              "type": "string"
            }
          ],
          "responses": [
            {
              "statusCode": "200",
              "description": "Success - validates parameter model generation",
              "content": {
                "application/json": {
                  "kind": "ref",
                  "name": "#/components/schemas/GetTest1ParametersId200Response"
                }
              }
            }
          ]
        },
        {
          "id": "testRequestInlineExtraction",
          "method": "post",
          "path": "/test-2-request",
          "summary": "Test 2: Request body inline schema extraction (Basic)",
          "description": "Validates extraction of inline schemas from request body into separate models. Tests: required fields, nested object extraction, format validation.",
          "parameters": [],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "kind": "ref",
                "name": "#/components/schemas/PostTest2RequestRequestBody"
              }
            }
          },
          "responses": [
            {
              "statusCode": "201",
              "description": "Created - validates simple response schema extraction",
              "content": {
                "application/json": {
                  "kind": "ref",
                  "name": "#/components/schemas/PostTest2Request201Response"
                }
              }
            }
          ]
        },
        {
          "id": "testResponseInlineExtraction",
          "method": "get",
          "path": "/test-3-response",
          "summary": "Test 3: Response inline schema extraction (Intermediate)",
          "description": "Validates extraction of inline schemas from response body into separate models. Tests: array items extraction, enum extraction, parameter model generation.",
          "parameters": [
            {
              "name": "page",
              "in": "query",
              "required": false,
              "type": "int",
              "defaultValue": 1
            },
            {
              "name": "limit",
              "in": "query",
              "required": false,
              "type": "int",
              "defaultValue": 10
            }
          ],
          "responses": [
            {
              "statusCode": "200",
              "description": "Primitive response - validates direct string return",
              "content": {
                "application/json": "string"
              }
            },
            {
              "statusCode": "201",
              "description": "Array response - validates direct array with inline objects",
              "content": {
                "application/json": {
                  "kind": "array",
                  "itemType": {
                    "kind": "ref",
                    "name": "schema"
                  }
                }
              }
            },
            {
              "statusCode": "202",
              "description": "Complex object response - validates nested object extraction",
              "content": {
                "application/json": {
                  "kind": "ref",
                  "name": "#/components/schemas/GetTest3Response202Response"
                }
              }
            },
            {
              "statusCode": "203",
              "description": "Direct schema reference - validates full schema $ref",
              "content": {
                "application/json": {
                  "kind": "ref",
                  "name": "UserResponse"
                }
              }
            }
          ]
        }
      ]
    }
  ]
