            "format": "int64"
          },
          "extensions": {
            "x-route-param": true
          }
        },
        {
          "name": "fields",
          "type": "string",
          "in": "query",
          "description": "Comma-separated list of fields to include",
          "defaultValue": "id,username,email",
          "validation": {
            "pattern": "^[a-z,]+$"
          },
          "extensions": {
            "x-example": "id,username,email,age"
          }
        },
        {
          "name": "includeDeleted",
          "type": "boolean",
          "in": "query",
          "description": "Include deleted users",
          "defaultValue": false,
          "deprecated": true,
          "extensions": {
            "x-deprecated-since": "1.5.0"
          }
        }
      ],
