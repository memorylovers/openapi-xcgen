{
  "metadata": {
    "title": "Validation and Metadata Test API",
    "version": "1.0.0",
    "description": "Test API for validation constraints, x-extensions, and metadata on properties and parameters"
  },
  "models": [
    {
      "kind": "object",
      "name": "UserProfile",
      "referencePath": "#/components/schemas/UserProfile",
      "properties": [
        {
          "name": "id",
          "type": "long",
          "description": "Unique user identifier",
          "readOnly": true,
          "validation": {
            "format": "int64"
          },
          "extensions": {
            "x-database-column": "user_id",
            "x-primary-key": true
          }
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "Username for login",
          "validation": {
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "extensions": {
            "x-validation-message": "Username must be 3-20 alphanumeric characters or underscore"
          }
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "description": "User email address",
          "validation": {
            "maxLength": 100,
            "format": "email"
          },
          "extensions": {
            "x-unique": true,
            "x-format": "rfc5322"
          }
        },
        {
          "name": "age",
          "type": "int",
          "description": "User age",
          "defaultValue": 18,
          "validation": {
            "minimum": 0,
            "maximum": 150
          },
          "extensions": {
            "x-unit": "years"
          }
        },
        {
          "name": "score",
          "type": "double",
          "description": "User score",
          "validation": {
            "minimum": 0,
            "maximum": 100,
            "format": "double"
          },
          "extensions": {
            "x-precision": 1
          }
        },
        {
          "name": "bio",
          "type": "string",
          "description": "User biography",
          "writeOnly": true,
          "validation": {
            "maxLength": 500
          },
          "extensions": {
            "x-encrypted": true
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "ref",
            "name": "#/components/schemas/UserProfileStatus"
          },
          "description": "Account status",
          "defaultValue": "active",
          "deprecated": true,
          "extensions": {
            "x-deprecated-reason": "Use accountState instead"
          }
        },
        {
          "name": "accountState",
          "type": {
            "kind": "ref",
            "name": "#/components/schemas/UserProfileAccountState"
          },
          "description": "Current account state",
          "defaultValue": "active"
        }
      ],
      "description": "User profile with comprehensive metadata"
    },
    {
      "kind": "enum",
      "name": "UserProfileStatus",
      "referencePath": "#/components/schemas/UserProfileStatus",
      "type": "string",
      "values": [
        {
          "value": "active",
          "name": "ACTIVE"
        },
        {
          "value": "inactive",
          "name": "INACTIVE"
        },
        {
          "value": "suspended",
          "name": "SUSPENDED"
        }
      ],
      "description": "Account status",
      "extensions": {
        "x-deprecated-reason": "Use accountState instead"
      }
    },
    {
      "kind": "enum",
      "name": "UserProfileAccountState",
      "referencePath": "#/components/schemas/UserProfileAccountState",
      "type": "string",
      "values": [
        {
          "value": "active",
          "name": "ACTIVE"
        },
        {
          "value": "inactive",
          "name": "INACTIVE"
        },
        {
          "value": "suspended",
          "name": "SUSPENDED"
        },
        {
          "value": "deleted",
          "name": "DELETED"
        }
      ],
      "description": "Current account state"
    },
