      "referencePath": "#/paths/::users/post/requestBody/content/application::json/schema",
      "properties": [
        {
          "name": "username",
          "type": "string",
          "required": true,
          "validation": {
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "extensions": {
