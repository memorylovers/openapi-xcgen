{
  "name": "@openapi-xcgen/core",
  "version": "0.0.0",
  "description": "Core utilities for OpenAPI code generation",
  "author": "Memory Lovers, LLC<https://github.com/memorylovers>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/memory-lovers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorylovers/openapi-xcgen.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/memorylovers/openapi-xcgen/issues"
  },
  "homepage": "https://github.com/memorylovers/openapi-xcgen#readme",
  "keywords": [
    "openapi",
    "code-generation",
    "typescript",
    "api-client"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "unbuild --stub",
    "build": "unbuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "regenerate:expected": "pnpm jiti tests/e2e/transformer/generate-expected.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/json-schema": "^7.0.15",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "es-toolkit": "^1.40.0",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^3.2.4",
    "openapi-types": "^12.1.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "openapi-types": "^12.1.3"
  }
}
