# Example secrets file for act
# Copy this file to .secrets and replace with actual values if needed
# For dry-run testing, these dummy values are sufficient

# NPM authentication token for publishing packages
# Required by: release-latest.yml, release-canary.yml
NPM_TOKEN=dummy-npm-token-for-testing

# Anthropic API key for Claude Code Action
# Required by: claud.yml
ANTHROPIC_API_KEY=dummy-anthropic-key-for-testing

# Note: GitHub token (GH_TOKEN/GITHUB_TOKEN) is automatically provided by act

