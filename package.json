{
  "name": "openapi-xcgen",
  "version": "0.0.0",
  "description": "Cross-language code generator for OpenAPI specifications",
  "author": "Memory Lovers, LLC<https://github.com/memorylovers>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo typecheck",
    "lint": "pnpm lint:ts && pnpm run '#lint' && pnpm lint:md",
    "lint:ts": "turbo lint",
    "lint:md": "markdownlint-cli2",
    "lint:actions": "./_scripts/lint-actions.sh",
    "lint:fix": "pnpm lint:fix:ts && pnpm run '#lint:fix' && pnpm lint:md:fix",
    "lint:fix:ts": "turbo lint:fix",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage",
    "test:actions": "./_scripts/test-actions.sh all",
    "test:actions:release-latest": "./_scripts/test-actions.sh release-latest",
    "test:actions:release-canary": "./_scripts/test-actions.sh release-canary",
    "release": "lerna version && git push --follow-tags",
    "sync:rules": "rulesync generate",
    "sync:rules:watch": "rulesync watch",
    "#lint": "eslint .",
    "#lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@lerna-lite/cli": "^4.9.1",
    "@lerna-lite/publish": "^4.9.1",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "rulesync": "^3.10.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/memory-lovers",
  "homepage": "https://github.com/memorylovers/openapi-xcgen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memorylovers/openapi-xcgen.git"
  },
  "bugs": {
    "url": "https://github.com/memorylovers/openapi-xcgen/issues"
  },
  "keywords": [
    "openapi",
    "codegen",
    "typescript",
    "dart",
    "generator",
    "cross-language"
  ]
}
